# Copy to .env.local for local development, and set the same keys in Vercel → Settings → Environment Variables.
# Nothing here is required to run the site: without these, every form shows an honest closed state.

# ── Contact form (work orders) ──────────────────────────────────────────────
RESEND_API_KEY=            # one key for work orders and Field Notes (needs full access for contacts and broadcasts)
CONTACT_FROM=              # e.g. Anurag Gautam <hello@anuraggautam.com>
CONTACT_TO=                # comma-separated inbox(es) that receive work orders

# ── Field Notes by email (PLAN_V3 §4) ───────────────────────────────────────
# The newsletter turns on only when RESEND_API_KEY, SUBSCRIBE_SECRET, a from address,
# RESEND_SEGMENT_ID and RESEND_TOPIC_NOTES_ID are all set.
SUBSCRIBE_SECRET=          # 32+ random bytes, e.g. `openssl rand -base64 48`. Seals confirm links (AES-256-GCM).
NEWSLETTER_FROM=           # e.g. Anurag Gautam <notes@updates.anuraggautam.com> (falls back to CONTACT_FROM). The subdomain needs SPF, DKIM and DMARC.
NEWSLETTER_REPLY_TO=       # optional; defaults to hello@anuraggautam.com
NEWSLETTER_POSTAL_ADDRESS= # required to broadcast (CAN-SPAM). A PO box is fine. The cron refuses to send without it.

# Printed by `node scripts/newsletter-setup.mjs` (idempotent; run it once the API key is set):
RESEND_SEGMENT_ID=
RESEND_TOPIC_NOTES_ID=
RESEND_TOPIC_EVENTS_ID=
RESEND_TOPIC_COMMUNITY_ID=
RESEND_TOPIC_COHORT_ID=

# ── Auto-send for new notes (vercel.json cron, daily 09:00 IST) ─────────────
CRON_SECRET=               # Vercel sends it as `Authorization: Bearer <CRON_SECRET>`. 16+ random characters.
